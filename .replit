modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:visits-dedup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:admin-self-protect"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:inkind-receipt-mobile"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:ticker-auto-refresh"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:receipt-strip-whatsapp"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:inkind-receipt-strip-narrow"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:inkind-receipt-long-desc"

[[workflows.workflow]]
name = "test:visits-dedup"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:visits"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:admin-self-protect"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:admin-self-protect"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:inkind-receipt-mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:inkind-receipt-mobile"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:ticker-auto-refresh"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:ticker-auto-refresh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:receipt-strip-whatsapp"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:receipt-strip-whatsapp"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "test:inkind-receipt-strip-narrow"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:inkind-receipt-strip-narrow"

[[workflows.workflow]]
name = "test:inkind-receipt-long-desc"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:inkind-receipt-long-desc"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-c44d9783-8c22-4c2f-8316-67fd48064864"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 25427
externalPort = 80

{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:visits": "node ./tests/visits-dedup.test.mjs",
    "test:admin-self-protect": "node ./tests/admin-self-protect.test.mjs",
    "test:admin-deleted-session": "node ./tests/admin-deleted-session.test.mjs",
    "test:receipt-long-name": "node ./tests/receipt-long-name.test.mjs",
    "test:receipt-long-amount": "node ./tests/receipt-long-amount.test.mjs",
    "test:receipt-pdf-page-count": "node ./tests/receipt-pdf-page-count.test.mjs",
    "test:receipt-small-amount": "node ./tests/receipt-small-amount.test.mjs",
    "test:inkind-receipt-long-desc": "node ./tests/inkind-receipt-long-desc.test.mjs",
    "test:inkind-receipt-pdf-page-count": "node ./tests/inkind-receipt-pdf-page-count.test.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.0",
    "thread-stream": "3.1.0"
  }
}
